      ]
    },
    {
      "id": "occasion-entry",
      "requiredFields": [
        "occasion-title",
        "occasion-action"
      ],
      "optionalFields": [
        "source-artwork",
        "source-dates",
        "associated-offer-count"
      ]
    },
    {
      "id": "guide-entry",
      "requiredFields": [
        "article-title",
        "article-action"
      ],
      "optionalFields": [
        "source-cover",
        "source-summary",
        "source-date"
      ]
    }
  ],
  "forbiddenModules": [
    "auth",
    "newsletter",
    "community",
    "cashback",
    "extension",
    "advertising",
    "fake-social-proof",
    "shopping-how-it-works",
    "decorative-eyebrow"
  ],
  "forbiddenOfferFields": [
    "description-paragraph",
    "invented-discount",
    "unverified-success-rate",
    "fake-usage-count",
    "fake-rating"
  ],
  "states": [
    "masked-code-entry",
    "intentional-reveal-copy",
    "copy-denied-feedback",
    "reload-remask",
    "no-code-shop",
    "expired-no-claim",
    "search-empty-query",
    "search-no-match",
    "filter-real-visible-results",
    "long-title",
    "missing-optional-content",
    "narrow-layout",
    "expired-excluded"
  ],
  "freedom": [
    "palette",
    "font-family",
    "campaign-composition",
    "component-geometry",
    "spacing-and-rhythm",
    "density",
    "column-count",
    "module-order-except-business-order",
    "imagery-and-topic-art",
    "action-silhouette",
    "responsive-composition"
  ],
  "businessOrder": [
    "offer-detail: main-coupon > related-offers > recommended-stores; recommended-stores is last main shopping module",
    "home: saving-guides last or penultimate when enabled"
  ],
  "legacyScope": "Existing projects are unchanged unless explicitly adopted; historical artifacts keep their frozen contract.",
