        "artwork",
        "action"
      ],
      "optionalFields": [
        "supporting-copy"
      ]
    },
    {
      "id": "offer-entry",
      "requiredFields": [
        "merchant-logo",
        "merchant-name",
        "offer-title",
        "expiry-or-unknown",
        "action"
      ],
      "optionalFields": [
        "offer-type",
        "category"
      ]
    },
    {
      "id": "main-coupon",
      "requiredFields": [
        "merchant-logo",
        "merchant-name",
        "offer-title",
        "expiry-or-unknown",
        "offer-type",
        "code-deal-expired-action-state"
      ],
      "optionalFields": []
    },
    {
      "id": "store-entry",
      "requiredFields": [
        "merchant-logo",
        "merchant-name",
        "active-offer-count",
        "store-action"
      ],
      "optionalFields": [
        "category"
      ]
    },
    {
      "id": "store-identity",
      "requiredFields": [
        "merchant-logo",
        "merchant-name",
        "active-offer-count"
      ],
      "optionalFields": [
